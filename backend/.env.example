# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pranexia_connect
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_ORIGINS=http://localhost:4200

# WhatsApp / Meta
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_webhook_verify_token
WHATSAPP_APP_SECRET=replace_with_your_meta_app_secret
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=vXX.X
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key

# Media storage. Limits are in megabytes. Local storage is appropriate only when
# its volume is durable and private; use an object-storage provider in production.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_STORAGE_PATH=storage/media
MEDIA_MAX_IMAGE_SIZE=5
MEDIA_MAX_VIDEO_SIZE=16
MEDIA_MAX_DOCUMENT_SIZE=100
# Reserved for a future S3-compatible storage provider implementation.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Google OAuth 2.0 / Identity Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Configure production values in your hosting provider's environment variables.
# Never commit real secrets, credentials, or production tokens to source control.
